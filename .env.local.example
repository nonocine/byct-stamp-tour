# Supabase 프로젝트 설정
# https://supabase.com/dashboard 에서 프로젝트 생성 후 아래 값을 채워주세요

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 관리자 비밀번호 (기본값: byct2026)
NEXT_PUBLIC_ADMIN_PASSWORD=byct2026

# ── 서버 전용 (NEXT_PUBLIC_ 절대 붙이지 말 것) ─────────────────────────────
# service_role 키. RLS를 우회하므로 브라우저에 노출되면 DB 전체가 열린다.
# Supabase 대시보드 → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 관리자 세션 쿠키 HMAC 서명 키 (32자 이상).
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 값을 바꾸면 기존 관리자 세션이 전부 무효화되어 재로그인이 필요하다.
ADMIN_SESSION_SECRET=

# 문자 공지 (슈퍼관리자 → 소감문 탭 → 문자 공지). 서버 전용 — NEXT_PUBLIC 붙이지 말 것.
# 문자 중계 서버(sms-relay, 알리고 경유). dongrae-business-trip 과 같은 서버.
SMS_RELAY_URL=
SMS_RELAY_KEY=
# 선택: 발신번호(숫자만). 비우면 중계 서버의 기본 발신번호.
SMS_SENDER=
